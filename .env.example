# Copy this file to the repository-root .env for LOCAL testing, then fill in
# only the keys you need. Never put real keys in .env.example or commit .env.
# A physical phone uses apps/mobile/.env, which must contain only public URLs;
# never put any API key in an EXPO_PUBLIC_* variable.
# For UAT/production, replace every local URL and JWT_SECRET in the server's
# private environment variables. The examples below are NOT production-safe.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://wisebasket:wisebasket@localhost:5432/wisebasket
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# DeepSeek: receipt interpretation/cloud comparison only; not planner logic.
# Use a NEW rotated key. Do not reuse a key previously pasted into chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_ENABLED=false
LLM_TIMEOUT_S=30

# Epic 6 local receipt pipeline. Leave REDIS_URL empty to process inline.
# Start inference on localhost:8001 before testing receipt uploads.
# If API runs inside Docker, localhost is the API container: set INFERENCE_URL
# to an address that the API container can actually reach instead.
REDIS_URL=
INFERENCE_URL=http://localhost:8001
INFERENCE_TIMEOUT_S=180
RECEIPT_UPLOADS_PER_DAY=10
RECEIPT_PROCESSING_DEADLINE_S=240
# All environments default to cached DONE-image reuse. Only explicit QA model
# comparisons should set true; production rejects true. Active images coalesce.
# Each fresh analysis consumes quota/model budget; cache reuse does not.
RECEIPT_REPROCESS_DONE_UPLOADS=false
# UAT/staging default true; other environments default false. Set false in UAT
# to test production duplicate protection. True is rejected outside QA/test.
# Re-uploading a confirmed image starts a new test purchase from saved rows;
# retrying/confirming the SAME receipt never adds stock twice.
# RECEIPT_ALLOW_REPEAT_PURCHASES=false
# UAT-only switch: require the cloud provider instead of local OCR fallback.
RECEIPT_CLOUD_REQUIRED=false

# Cloud receipt calls remain OFF after keys are filled. Enable them only after
# the five local redaction checks, key rotation, and a fresh provider-price
# verification. Test one provider at a time: deepseek | kimi | azure.
# With DeepSeek, a reviewable first image result may use the second (text-only)
# paid call for ranked canonical_food hints; the DB budget still caps each
# receipt at two calls total. Hints never confirm a food automatically.
RECEIPT_CLOUD_ENABLED=false
RECEIPT_CLOUD_PROVIDER=local
RECEIPT_CLOUD_KEYS_ROTATED=false
# Empty disables paid OCR. After independently rechecking current model/SKU
# and prices, set only the applicable marker(s), comma-separated for a
# three-provider PRIVATE evaluation: deepseek-v4.1-flash-2026-09-10,
# kimi-k3-cny-2026-09-24-fx-floor-5,azure-f0-2024-11-30.
# Never turn this on merely by copying an old price marker.
RECEIPT_CLOUD_PRICE_VERSION=
RECEIPT_CLOUD_MONTHLY_BUDGET_USD=10

# Moonshot/Kimi. Use a NEW rotated server-side key.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Azure Document Intelligence (prebuilt-receipt), East Asia F0 resource.
# Keep the key empty here; fill it only in the ignored .env file.
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://wisebasket-receipt-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_SKU=F0

# Optional Geoapify key for manual typed location search (not needed for OCR).
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode/autocomplete
GEOAPIFY_TIMEOUT_S=5
