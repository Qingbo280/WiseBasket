{
  "expo": {
    "owner": "wisebasket2026",
    "name": "WiseBasket",
    "slug": "wisebasket",
    "scheme": "wisebasket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/price-check/brand-basket.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wisebasket.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.wisebasket.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/price-check/brand-basket.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/price-check/brand-basket.png",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WiseBasket to use your location when you choose current-location planning."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow WiseBasket to use your camera to photograph grocery receipts.",
          "photosPermission": "Allow WiseBasket to access your photos so you can upload grocery receipts."
        }
      ],
      "expo-status-bar",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "694b075b-aadf-4124-afe5-948b2e371b6c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/694b075b-aadf-4124-afe5-948b2e371b6c"
    }
  }
}
